{
  "name": "calendar-share",
  "version": "0.1.0",
  "private": true,
  "description": "One-way projection of selected Google Calendars into one read-only calendar.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:google": "node scripts/google-deploy.mjs",
    "deploy": "node scripts/google-deploy.mjs --update",
    "push:google": "npm run build && clasp push --force",
    "clasp:open": "clasp open"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
